def tower_hanoi(n, source, destination, auxiliary):
  if n == 1:
    print(f"Move disk 1 from {source} to {destination}")
    return
  tower_hanoi(n - 1, source, auxiliary, destination)
  print(f"Move disk {n} from {source} to {destination}")
  tower_hanoi(n - 1, auxiliary, destination, source)
num_disks = 3
print(f"\n--- Tower of Hanoi with {num_disks} disks ---")
tower_hanoi(num_disks, 'A', 'C', 'B') 

